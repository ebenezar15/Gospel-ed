{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "types": ["vite/client", "node"],
    "noUnusedLocals": false, "allowImportingTsExtensions": false
  },
  "include": ["src", "scripts"]
}
